# IBKR credentials for headless IB Gateway (ib-gateway-docker)
# ──────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (which is gitignored) and fill in your values.
# NEVER commit the real .env file.

# Your IBKR username and password
TWS_USERID=your_username_here
TWS_PASSWORD=your_password_here

# paper = paper trading account (port 4002)
# live  = REAL MONEY account (port 4001) — only switch after months of paper
TRADING_MODE=paper

# Read-only API: 'yes' blocks all order placement (extra safety while testing
# data + connectivity). Set to 'no' once you're ready to actually trade.
READ_ONLY_API=yes

# Timezone for the Gateway's daily auto-restart
TZ=America/New_York
